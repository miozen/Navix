{
  "name": "navix",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NAV_DB",
      "id": "REPLACE_WITH_PRODUCTION_KV_ID"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "preview": {
      "name": "navix-preview",
      "kv_namespaces": [
        {
          "binding": "NAV_DB",
          "id": "REPLACE_WITH_PREVIEW_KV_ID"
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview"
      }
    }
  }
}
